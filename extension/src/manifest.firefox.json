{
  "manifest_version": 3,
  "name": "So7baFit Web Translator",
  "version": "1.0.0",
  "description": "Translate words on any page and sync them to your So7baFit account.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "So7baFit Translator"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-translator@so7bafit.com",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://so7bafit.com/*",
    "https://www.so7bafit.com/*",
    "https://api.so7bafit.com/*",
    "http://localhost:3000/*",
    "http://localhost:3030/*",
    "http://localhost:8083/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3030/*",
    "http://127.0.0.1:8083/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate the current selection"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
